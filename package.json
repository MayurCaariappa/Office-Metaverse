{
  "name": "office-metaverse",
  "private": true,
  "scripts": {
    "dev:backend": "tsx watch backend/src/server.ts",
    "dev:frontend": "npm run dev --prefix frontend",
    "dev": "concurrently -k \"npm run dev:backend\" \"npm run dev:frontend\"",
    "build:backend": "tsc -p backend/tsconfig.json",
    "build:frontend": "npm run build --prefix frontend",
    "build": "npm run build:backend && npm run build:frontend",
    "lint:backend": "eslint backend/src --config eslint.config.mjs",
    "lint:frontend": "npm run lint --prefix frontend",
    "lint": "npm run lint:backend && npm run lint:frontend",
    "test:backend": "npm run build:backend && node --import tsx --test tests/backend/app.test.ts",
    "test:frontend": "npm run test --prefix frontend -- --run",
    "test": "npm run test:backend && npm run test:frontend",
    "start": "node backend/dist/server.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^17.3.1",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.16.4",
    "multer": "^2.0.2",
    "ws": "^8.18.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.1.0",
    "@types/node": "^25.5.0",
    "@types/supertest": "^7.2.0",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.57.1",
    "@typescript-eslint/parser": "^8.57.1",
    "concurrently": "^9.1.0",
    "eslint": "^10.1.0",
    "supertest": "^7.2.2",
    "tailwindcss": "^4.1.12",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
